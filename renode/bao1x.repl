// duart_console.repl -- minimal Renode PythonPeripheral model of the
// real Baochip-1x DUART (Debug UART) peripheral.
//
// Real hardware registers (bao1x_peri.svd, base 0x40042000,
// rtl/modules/core/rtl/duart.sv):
//   SFR_TXD @ 0x0000 -- write: transmit one byte (low 8 bits)
//   SFR_CR  @ 0x0004 -- control register (not modeled: no real
//                        baud-rate/enable-gating behavior needed for a
//                        minimal console demo -- reads back 0)
//   SFR_SR  @ 0x0008 -- status register (bit 0: busy/ready). Modeled as
//                        always-ready (0) since DUART's real hardware is
//                        a bit-banged/software-loop UART with no FIFO;
//                        Renode's Python peripheral write handler runs
//                        synchronously, so "ready" is always true from
//                        the guest's point of view.
//
// This is NOT a byte-accurate hardware timing model (no baud-rate
// delay, no real transmit-busy window) -- it's the minimum needed to
// get real, visible console output out of guest code that writes to
// SFR_TXD, which is exactly what src/emu_trace.c's `uart_puts()`-style
// helpers do on the real chip (see docs/baochip-1x-memory-map-findings.md
// for DUART's confirmed real base address).
duart: Python.PythonPeripheral @ sysbus 0x40042000
    size: 0x1000
    initable: true
    script: '''
if request.IsInit:
    pass
if request.IsRead:
    # SFR_CR and SFR_SR both read back 0 (not gating anything, always ready)
    request.Value = 0
if request.IsWrite:
    if request.Offset == 0x0000:
        import sys
        sys.stdout.write(chr(request.Value & 0xFF))
        sys.stdout.flush()
'''

// iox_gpio.repl -- minimal Renode PythonPeripheral model of the real
// Baochip-1x IOX (GPIO/pin-crossbar) peripheral.
//
// Real hardware registers (bao1x_peri.svd, base 0x5012f000,
// confirmed via xous-core's libs/bao1x-hal/src/iox.rs +
// libs/bao1x-api/src/iox.rs -- the real driver used by
// services/bao1x-hal-service/src/servers/keyboard.rs for button
// reads). IoxPort enum: PA=0, PB=1, PC=2, PD=3, PE=4, PF=5 -- one
// 32-bit register per port (16 real pins used per port, one bit per
// pin), 6 ports per register group:
//
//   SFR_GPIOOE_CRGOE{0-5}  @ 0x148,0x14c,0x150,0x154,0x158,0x15c
//     -- direction register (real driver: Iox::set_gpio_dir, one
//        bit per pin, 1=output/0=input -- IoxDir::Output=1,
//        IoxDir::Input=0)
//   SFR_GPIOOUT_CRGO{0-5}  @ 0x130,0x134,0x138,0x13c,0x140,0x144
//     -- output value register (real driver: Iox::set_gpio_pin /
//        set_gpio_bank)
//   SFR_GPIOIN_SRGI{0-5}   @ 0x178,0x17c,0x180,0x184,0x188,0x18c
//     -- input value register (real driver: Iox::get_gpio_pin /
//        get_gpio_bank -- this is what firmware reads to see a real
//        button's current electrical state)
//   SFR_GPIOPU_CRGPU{0-5}  @ 0x160..0x174 -- pullup enable
//   SFR_AFSEL_CRAFSEL{0-11} @ 0x0..0x2c -- alternate-function select
//   SFR_PIOSEL @ 0x200 -- BIO pin-mux select bitmask
//   SFR_CFG_SCHM/SLEW/DRVSEL_* @ 0x230-0x274 -- Schmitt trigger,
//     slew rate, drive strength config
//   SFR_INTCR_CRINT{0-7} @ 0x100-0x11c, SFR_INTFR @ 0x120 --
//     interrupt config/flags (NOT modeled behaviorally here -- see
//     "Known limitations" in renode/README.md; reads/writes are
//     stored but no real edge-detection/IRQ firing happens)
//
// MVP scope (per baoregon-trail issue #2): models real GPIO
// input/output/direction register read/write semantics faithfully
// enough to let firmware read a simulated button press through the
// real register layout. Does NOT model: interrupts/edge detection,
// alternate-function routing side effects, BIO pin muxing side
// effects, or drive-strength/slew/schmitt-trigger electrical behavior
// -- all of those registers are present (so writes/reads don't fault)
// but are simple storage with no behavioral effect.
//
// Simulating a button press: real hardware drives SFR_GPIOIN_SRGI{n}
// bits from actual external pin voltage; this model has no real pin
// wiring, so the *test* mechanism is to directly poke the SFR_GPIOIN_
// SRGI{n} register via Renode's `sysbus WriteDoubleWord` monitor
// command (see renode/bao1x_iox_gpio_test.resc) -- this is a real,
// legitimate stand-in for "an external pin transitioned", not a
// firmware code path.
iox: Python.PythonPeripheral @ sysbus 0x5012f000
    size: 0x1000
    initable: true
    script: '''
if request.IsInit:
    regs = [0] * (0x1000 // 4)
if request.IsRead:
    idx = request.Offset >> 2
    request.Value = regs[idx] if idx < len(regs) else 0
if request.IsWrite:
    idx = request.Offset >> 2
    if idx < len(regs):
        regs[idx] = request.Value & 0xFFFFFFFF
'''

// udma_spim.repl -- Renode PythonPeripheral model of the real Baochip-1x
// UDMA_SPIM_0 peripheral, which drives the memory-LCD display over
// SPI (see services/graphics-server/src/backend/bao1x.rs in xous-core).
//
// Real hardware registers (bao1x_peri.svd, base 0x50105000):
//   REG_RX_SADDR/SIZE/CFG   @ 0x00/0x04/0x08 (Bank::Rx)
//   REG_TX_SADDR/SIZE/CFG   @ 0x10/0x14/0x18 (Bank::Tx)
//   REG_CMD_SADDR/SIZE/CFG  @ 0x20/0x24/0x28 (Bank::Custom)
//   REG_STATUS              @ 0x30
// CFG register bit 4 = r_*_en (write triggers the DMA), bit 6 = r_*_clr.
// This exactly matches libs/bao1x-hal/src/udma/mod.rs's generic `Udma`
// trait (Bank::Rx=0, Bank::Tx=0x10/4, Bank::Custom=0x20/4; DmaReg::
// Saddr=0, Size=1, Cfg=2; CFG_EN=0b01_0000, CFG_CLEAR=0b100_0000).
//
// The real protocol (libs/bao1x-hal/src/udma/spim.rs's `SpimCmd` enum):
// firmware writes a small list of 32-bit COMMAND WORDS into an IFRAM
// buffer, points REG_CMD_SADDR/SIZE at it, then sets REG_CMD_CFG's EN
// bit -- the peripheral fetches and executes each command word in
// order. Top 4 bits (31:28) are the opcode:
//   0=Config, 1=StartXfer(cs), 2=SendCmd, 3=SendAddr, 4=Dummy,
//   5=Wait, 6=TxData, 7=RxData, 8=RepeatNextCmd, 9=EndXfer,
//   10=EndRepeat, 11=RxCheck, 12=FullDuplex.
// StartXfer(cs) asserts chip-select (real hardware: also a GPIO
// bit-bang per bao1x.rs's own doc comment, out of scope here -- IOX
// GPIO is a separate peripheral already modeled). TxData(mode,
// words_per_xfer, bits_per_word, endian, len) is the one this model
// actually implements with real shift-out semantics: it tells the
// peripheral to fetch `len` words from the TX bank (REG_TX_SADDR/SIZE,
// already set up by firmware) and shift them out over "SPI" -- this
// model captures those bytes into `spi_captured` so a test can verify
// real command/data content and ordering, not just "didn't crash".
//
// Scope/limitations (matching IOX/DUART's own documented pattern):
// models REAL register offsets and REAL command-word decode/dispatch
// for the commands that matter to a display blit (StartXfer, TxData,
// EndXfer) with real DMA-fetch-from-memory semantics (genuinely reads
// the caller's IFRAM buffer via the sysbus, not a fake/inert stub).
// Does NOT model: Config/SendCmd/SendAddr/Dummy/Wait/RxData/
// RepeatNextCmd/EndRepeat/RxCheck/FullDuplex (harmlessly no-op'd --
// logged but not acted on), real SPI clock timing, or the CS-pin GPIO
// bit-bang side (that's IOX's job, already modeled separately;
// StartXfer here just tracks an internal `cs_asserted` flag for
// realism/assertions, it does not touch any real IOX register).
udma_spim0: Python.PythonPeripheral @ sysbus 0x50105000
    size: 0x1000
    initable: true
    script: '''
def _dispatch_cmd_list():
    global cs_asserted, spi_captured
    machine = self.GetMachine()
    sysbus_periph = machine.SystemBus
    remaining = cmd_size
    addr = cmd_saddr
    # Command words are 32-bit; cmd_size is documented in bytes per
    # the SVD's r_cmd_size field (same convention as r_tx_size/
    # r_rx_size), so iterate 4 bytes at a time.
    while remaining >= 4:
        word = sysbus_periph.ReadDoubleWord(addr)
        opcode = (word >> 28) & 0xF
        if opcode == 1:
            # StartXfer(cs) -- assert chip-select
            cs_asserted = True
        elif opcode == 6:
            # TxData(mode, words_per_xfer, bits_per_word, endian, len)
            # len is encoded as (len - 1) per SpimCmd::TxData's real
            # Into<u32> impl -- decode the low 16 bits + 1.
            tx_len_words = (word & 0xFFFF) + 1
            _shift_out_tx_data(sysbus_periph, tx_len_words)
        elif opcode == 9:
            # EndXfer(event) -- de-assert chip-select
            cs_asserted = False
        # else: Config/SendCmd/SendAddr/Dummy/Wait/RxData/
        # RepeatNextCmd/EndRepeat/RxCheck/FullDuplex -- not modeled,
        # intentionally no-op (see file header "Scope/limitations").
        addr = addr + 4
        remaining = remaining - 4

def _shift_out_tx_data(sysbus_periph, num_words):
    global spi_captured
    addr = tx_saddr
    for _ in range(num_words):
        val = sysbus_periph.ReadDoubleWord(addr)
        spi_captured.append(val & 0xFF)
        spi_captured.append((val >> 8) & 0xFF)
        spi_captured.append((val >> 16) & 0xFF)
        spi_captured.append((val >> 24) & 0xFF)
        addr = addr + 4

if request.IsInit:
    regs = [0] * (0x1000 // 4)
    tx_saddr = 0
    tx_size = 0
    cmd_saddr = 0
    cmd_size = 0
    cs_asserted = False
    spi_captured = []

if request.IsRead:
    idx = request.Offset >> 2
    if request.Offset == 0x30:
        # REG_STATUS: bit meaning is unconfirmed in the SVD's own field
        # docs (just "status_i", no bit breakdown given) -- model as
        # always-idle (0), matching this model's synchronous dispatch
        # (no real busy window, same rationale as duart_console.repl's
        # SFR_SR).
        request.Value = 0
    elif request.Offset == 0x38:
        # NOT a real hardware register (0x38 is past REG_STATUS,
        # unused in the real SVD) -- test/debug-only hook so a .resc
        # test script can verify captured SPI bytes without needing
        # a full firmware round-trip. Prints spi_captured and returns
        # its length; real firmware never touches this offset.
        import sys
        sys.stdout.write("SPI_CAPTURED=" + repr(spi_captured) + " CS=" + repr(cs_asserted))
        sys.stdout.flush()
        request.Value = len(spi_captured)
    elif idx < len(regs):
        request.Value = regs[idx]
    else:
        request.Value = 0

if request.IsWrite:
    idx = request.Offset >> 2
    if idx < len(regs):
        regs[idx] = request.Value & 0xFFFFFFFF

    if request.Offset == 0x10:
        # Real driver writes a full 32-bit IFRAM physical address here
        # (libs/bao1x-hal/src/udma/mod.rs's udma_enqueue():
        # write_volatile(buf_addr) where buf_addr = buf.as_ptr() as
        # u32) -- NOT masked to the SVD's documented 12-bit field
        # width, which appears to only describe the low bits actually
        # wired up in RTL for a smaller address space than the real
        # 32-bit pointer firmware supplies. Store the full value so
        # this model can genuinely dereference it via the sysbus.
        tx_saddr = request.Value & 0xFFFFFFFF
    elif request.Offset == 0x14:
        tx_size = request.Value & 0xFFFF
    elif request.Offset == 0x20:
        cmd_saddr = request.Value & 0xFFFFFFFF
    elif request.Offset == 0x24:
        cmd_size = request.Value & 0xFFFF
    elif request.Offset == 0x28:
        # REG_CMD_CFG: bit 4 = r_cmd_en (start), bit 6 = r_cmd_clr
        if request.Value & 0x10:
            _dispatch_cmd_list()
'''
// udc_usb.repl -- minimal Renode PythonPeripheral model of the real
// Baochip-1x UDC (USB Device Controller) peripheral -- a Corigine
// xHCI-compliant USB3 device controller core.
//
// Real hardware registers/addresses (confirmed via xous-core's
// libs/bao1x-hal/src/usb/utra.rs + driver.rs -- the real driver, NOT
// assumed generic USB semantics):
//
//   CORIGINE_USB_BASE   = 0x50202000  (real base, per utra.rs)
//   CORIGINE_DEV_OFFSET = 0x400       (device registers start here)
//   CORIGINE_USB_LEN    = 0x3000      (12KB region)
//
// NOTE on the address discrepancy: Xous's own generated header
// (utralib/src/generated/bao1x.rs) declares HW_UDC_MEM=0x50200000,
// HW_UDC_MEM_LEN=65536 (64KB) -- a BROADER region starting 0x2000
// earlier than utra.rs's CORIGINE_USB_BASE=0x50202000. Both are real,
// from real generated/hand-written source; the 64KB Xous region likely
// also covers IFRAM buffer space and/or other UDC-adjacent blocks not
// broken out in utra.rs. This model maps the full 64KB region at
// 0x50200000 (matching Xous's own header, the more conservative/
// inclusive choice for address-collision detection) but only
// implements REAL register behavior for the offsets utra.rs actually
// documents (0x400 + register offset below), consistent with the
// DUART/IOX/SPIM models' own precedent of "real addressing, not full
// behavioral hardware simulation" for anything not exercised by real
// driver code.
//
// Real register offsets (relative to CORIGINE_DEV_OFFSET=0x400,
// confirmed in utra.rs):
//   DEVCAP     @ 0x400+0x00  -- device capabilities (read-only in
//                               real hardware; real driver's own
//                               reset() expects to read back
//                               0x20014401 on real silicon)
//   DEVCONFIG  @ 0x400+0x10  -- max speed / USB3 disable count
//   USBCMD     @ 0x400+0x20  -- command register: bit0=RUN_STOP,
//                               bit1=SOFT_RESET, bit2=INT_ENABLE,
//                               bit3=SYS_ERR_ENABLE
//   USBSTS     @ 0x400+0x24  -- status register
//   PORTSC     @ 0x400+0x30  -- port status/control
//   DOORBELL   @ 0x400+0x40  -- ring doorbell (real driver:
//                               knock_doorbell() writes endpoint
//                               index here to kick off a transfer)
//   CMDPARA0   @ 0x400+0x70  -- command parameter 0
//   CMDPARA1   @ 0x400+0x74  -- command parameter 1
//   CMDCTRL    @ 0x400+0x78  -- command control: bit0=ACTIVE,
//                               bits[7:4]=TYPE, bits[19:16]=STATUS
//
// MVP scope (per baoregon-trail issue #2): models the two real,
// register-level hardware handshakes the actual driver
// (libs/bao1x-hal/src/usb/driver.rs) performs and busy-waits on:
//
//   1. Soft reset (driver.rs reset(), lines ~1253-1258): firmware
//      writes USBCMD_SOFT_RESET=1, then busy-waits reading USBCMD
//      until that bit reads back 0 again. Real hardware auto-clears
//      this bit once reset completes; this model does the same
//      (auto-clears on the very next read, since there's no real
//      reset latency to simulate).
//   2. Command execution (driver.rs issue_command(), lines
//      ~1506-1530): firmware writes CMDPARA0/CMDPARA1, then writes
//      CMDCTRL with ACTIVE=1 + TYPE=<cmd>, then busy-waits reading
//      CMDCTRL until ACTIVE reads back 0, then checks STATUS bits
//      for success/failure. Real hardware processes the command
//      asynchronously; this model completes it immediately (clears
//      ACTIVE, sets STATUS=0 for success) on the next read -- there
//      is no real xHCI TRB/command-ring/event-ring emulation here.
//
// DEVCAP is modeled as a fixed, real, hardware-documented read-only
// value (0x20014401, from driver.rs's own comment showing real
// silicon's actual DEVCAP readback) -- this lets firmware's real
// reset() sequence's own sanity printout ("devcap: 20014401") be
// exercised faithfully.
//
// NOT modeled at all (same "real addressing, not full behavioral
// simulation" precedent as DUART/IOX/SPIM): USB protocol semantics,
// TRB (Transfer Request Block) rings, event rings, endpoint context
// structures, IFRAM-based DMA buffer transfers, PORTSC real
// connect/speed-negotiation state machine, or interrupts. A full
// xHCI-compliant USB3 device controller is a substantially larger
// modeling effort than DUART/IOX/SPIM's simple register-level FIFOs
// -- out of scope for this MVP pass.
udc: Python.PythonPeripheral @ sysbus 0x50200000
    size: 0x10000
    initable: true
    script: '''
if request.IsInit:
    regs = [0] * (0x10000 // 4)
    # DEVCAP @ dev offset 0x400 + register offset 0x00 = 0x400
    # Real, documented value from driver.rs's own comment showing
    # real silicon's actual readback (1 interrupt, 4 phys EPIN, 4 phys
    # EPOUT configuration).
    regs[0x400 // 4] = 0x20014401
if request.IsRead:
    idx = request.Offset >> 2
    request.Value = regs[idx] if idx < len(regs) else 0
if request.IsWrite:
    idx = request.Offset >> 2
    if idx < len(regs):
        value = request.Value & 0xFFFFFFFF
        # USBCMD @ dev offset 0x400 + 0x20 = 0x420: auto-clear
        # SOFT_RESET (bit 1) immediately, matching real hardware's
        # own "reset completes, bit self-clears" behavior that
        # driver.rs's reset() busy-waits on.
        if request.Offset == 0x420:
            regs[idx] = value & ~0x2
        # CMDCTRL @ dev offset 0x400 + 0x78 = 0x478: auto-clear
        # ACTIVE (bit 0) and force STATUS (bits 19:16) to 0 (success),
        # matching real hardware's own "command completed" behavior
        # that driver.rs's issue_command() busy-waits on.
        elif request.Offset == 0x478:
            regs[idx] = value & ~0x1 & ~0xF0000
        else:
            regs[idx] = value
'''
